# Python / Node 工具链缓存
.venv/
npm-cache/
node_modules/
__pycache__/

# 平台运行时产物（按项目落盘）；_shared 是渲染引擎源码，例外入库
data/**
!data/projects/
data/projects/*
!data/projects/_shared/
!data/projects/_shared/**
data/projects/_shared/__pycache__/

# OS / 编辑器
.DS_Store
Thumbs.db
*.log

# 环境变量（真实值不入库）
.env

# 本地构建产物
bin/
web/dist/

# 3D 验证片渲染产物（不入库）
demo/aegis3d/renders/

# ===== ↑ 以上同步自 .gitignore（「从 .gitignore 同步」只重写以上部分）=====
.git/
.hg/
.svn/
bower_components/
jspm_packages/
site-packages/
venv/
coverage/
htmlcov/
lcov-report/
cmakefiles/
cmake-build-*/
bazel-*/
pods/
deriveddata/
storybook-static/
playwright-report/
test-results/
allure-results/
allure-report/
cdk.out/
*.egg-info/
*.dist-info/
eggs/
pip-wheel-metadata/
wheels/
