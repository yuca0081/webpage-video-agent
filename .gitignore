.venv/
npm-cache/
node_modules/
__pycache__/

# 平台运行时数据（项目产物/方法库/样张），整目录不入库；渲染引擎源码在 ai/
data/

# OS / 编辑器
.DS_Store
Thumbs.db
*.log

# 环境变量（真实值不入库）
.env

