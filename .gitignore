# Python / Node 工具链缓存
.venv/
npm-cache/
node_modules/
__pycache__/

# 平台运行时产物（按项目落盘）；_shared 是渲染引擎源码，例外入库
data/**
!data/projects/
data/projects/*
!data/projects/_shared/
!data/projects/_shared/**
data/projects/_shared/__pycache__/

# OS / 编辑器
.DS_Store
Thumbs.db
*.log

# 环境变量（真实值不入库）
.env

# 本地构建产物
bin/
web/dist/

# 3D 验证片渲染产物（不入库）
demo/aegis3d/renders/

# 多风格验证管线产物（style_test_harness.py 可再生）
demo/styletest/
