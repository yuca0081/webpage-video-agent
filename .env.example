# 帧述 运行配置（复制为 .env 后填写真实值；.env 不入库）

# ── M0（当前）──────────────────────────────
DATA_DIR=data
LLM_MODE=manual          # manual=会话模式（文件契约，AI 本人担任 LLM）| api=LLM API（OpenAI 兼容）

# ── LLM（API 模式时启用）：默认 GLM 编码套餐端点 ──
LLM_API_KEY=
# LLM_MODEL=glm-5.3-flash   # 默认；换 glm-5.3 更强
# LLM_BASE_URL=https://open.bigmodel.cn/api/coding/paas/v4   # 默认；按量计费/DeepSeek 换 https://api.deepseek.com/v1

# ── TTS（可选，2026-09-23：配音质量升级）─────
# 硅基流动 CosyVoice2（有免费额度，中文比 Kokoro 自然得多）；
# 注册 https://siliconflow.cn → API Keys → 填到这里即自动启用，无 key 回落 Kokoro 离线
SILICONFLOW_API_KEY=
# TTS_VOICE=FunAudioLLM/CosyVoice2-0.5B:alex   # 备选 :benjamin :charles :david，出片 A/B 后定

# ── M1：原服务器（47.94.247.12）─────────────
