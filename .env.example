# 帧述 运行配置（复制为 .env 后填写真实值；.env 不入库）

# ── M0（当前）──────────────────────────────
DATA_DIR=data
LLM_MODE=manual          # manual=会话模式（文件契约，AI 本人担任 LLM）| api=DeepSeek

# ── LLM（API 模式时启用）────────────────────
DEEPSEEK_API_KEY=sk-xxx

# ── M1：原服务器（47.94.247.12）─────────────
# ⚠️ 两件事没完成前以下 PG/MinIO 不可用：
#   1) postgres18 容器未映射 5432（docker ps 显示 PORTS 为空）→ 需重建容器加 -p 5432:5432
#   2) 阿里云安全组未放行 5432/9000（2026-09-22 从开发机实测三端口全不通）
#      → 建议只放行 新服务器IP + 开发机IP
PG_DSN=host=47.94.247.12 port=5432 user=zhenshu password=TODO dbname=zhenshu sslmode=disable
MINIO_ENDPOINT=47.94.247.12:9000
MINIO_ACCESS_KEY=TODO
MINIO_SECRET_KEY=TODO
MINIO_BUCKET=zhenshu

